# Vercel ortam değişkenleri (Project → Settings → Environment Variables).
# Vercel Marketplace entegrasyonları DATABASE_URL / REDIS_URL değerlerini otomatik ekleyebilir.

# Yönetilen PostgreSQL (ör. Neon). POSTGRES_URL de kabul edilir.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Bağlantı havuzu üst sınırı (fonksiyon başına). Varsayılan 5.
DATABASE_POOL_MAX=5

# Yönetilen Redis, TCP bağlantısı (redis:// veya rediss://). REST URL'si yeterli değildir: pub/sub gerekir. KV_URL de kabul edilir.
REDIS_URL=rediss://default:password@host:6379

# Oturum imzalama gizli anahtarı, en az 32 karakter. Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Davet linklerinde kullanılan genel adres. Boşsa VERCEL_PROJECT_PRODUCTION_URL kullanılır.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# İsteğe bağlı: WebSocket ve API için izin verilen ek origin'ler (virgülle). Boşsa yalnızca istek host'u kabul edilir.
ALLOWED_ORIGINS=

# İsteğe bağlı oran sınırları
# OKEY_CMD_RATE_LIMIT=40   # 10 sn'de oyuncu başına oyun komutu
# OKEY_WS_MSG_LIMIT=80     # 5 sn'de bağlantı başına WebSocket mesajı

# YALNIZCA YEREL GELİŞTİRME: DATABASE_URL yoksa `npm run dev` gömülü PGlite kullanır.
# OKEY_DEV_DB=pglite:./.pglite
